{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LOADFORGE_SANITIZER": "address" }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LOADFORGE_SANITIZER": "thread" }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage (100% line and branch gate)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LOADFORGE_COVERAGE": "ON" }
    },
    {
      "name": "simd-scalar",
      "inherits": "base",
      "displayName": "Scalar-only (proves no ISA intrinsic leaked into portable code)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LOADFORGE_SIMD": "scalar" }
    },
    {
      "name": "static",
      "inherits": "base",
      "displayName": "Static release artifact (live/rescue media)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOADFORGE_STATIC": "ON",
        "LOADFORGE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "simd-scalar", "configurePreset": "simd-scalar" },
    { "name": "static", "configurePreset": "static" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    { "name": "simd-scalar", "configurePreset": "simd-scalar", "output": { "outputOnFailure": true } }
  ]
}
