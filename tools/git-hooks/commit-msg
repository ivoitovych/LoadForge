#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# LOADFORGE-REPO-HOOK
#
# Message gate: the only trailer a message may carry is Signed-off-by, and one
# Signed-off-by must name the author identity about to be recorded. This is
# tools/check-commit-identity.sh and tools/check-dco.sh, applied before the
# commit exists. Trailers are allowlisted, never listed by name.
set -uo pipefail

msg="${1:?usage: commit-msg <message-file>}"
bad=0
trailers="$(git stripspace --strip-comments < "$msg" | git interpret-trailers --parse)"

while IFS= read -r key; do
  [ -z "$key" ] || [ "$key" = "Signed-off-by" ] || {
    echo "commit-msg: trailer '$key'; only Signed-off-by is allowed." >&2; bad=1; }
done < <(sed -n 's/^\([^:]*\):.*/\1/p' <<< "$trailers")

# A "-by:" line above the closing paragraph is not a trailer to git, but it
# reads as one to a person and to every tool that greps for it. Anywhere in the
# message, the only line of that shape allowed is Signed-off-by.
while IFS= read -r key; do
  echo "commit-msg: a '$key' line; only Signed-off-by is allowed." >&2; bad=1
done < <(git stripspace --strip-comments < "$msg" | grep -oiE '^[a-z][a-z0-9-]*-by:' | grep -viE '^signed-off-by:$')

ident="$(git var GIT_AUTHOR_IDENT)" || { echo "commit-msg: git has no author identity." >&2; exit 1; }
author="$(sed -n 's/.*<\(.*\)>.*/\1/p' <<< "$ident" | tr '[:upper:]' '[:lower:]')"
found=1
while IFS= read -r email; do
  [ "$(tr '[:upper:]' '[:lower:]' <<< "$email")" = "$author" ] && found=0
done < <(sed -n 's/^Signed-off-by:.*<\(.*\)>.*/\1/p' <<< "$trailers")
if [ "$found" -ne 0 ]; then
  echo "commit-msg: no Signed-off-by for <$author>; commit with 'git commit -s'." >&2
  bad=1
fi
exit "$bad"
